{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": ".vitepress/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=604800, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/AI/TOP1",
      "destination": "https://www.aicando.xyz/",
      "permanent": true
    },
    {
      "source": "/AI/TOP1/",
      "destination": "https://www.aicando.xyz/",
      "permanent": true
    },
    {
      "source": "/AI/TOP1.html",
      "destination": "https://www.aicando.xyz/",
      "permanent": true
    },
    {
      "source": "/en/AI/TOP1",
      "destination": "https://www.aicando.xyz/",
      "permanent": true
    },
    {
      "source": "/en/AI/TOP1/",
      "destination": "https://www.aicando.xyz/",
      "permanent": true
    },
    {
      "source": "/en/AI/TOP1.html",
      "destination": "https://www.aicando.xyz/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/:path*.html"
    }
  ]
}
